# First release: only runtime source and essential package documentation.
/*
!/.gitignore
!/README.md
!/pyproject.toml
!/src/
/src/*
!/src/browser_reuse/

# Local environments and generated files.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
build/
dist/
.DS_Store
node_modules/
tests/
test_*.py
*_test.py
benchmarks/
experiments/
artifacts/
work/
tmp/
output/
outputs/
*.log
*.jsonl
*.db
*.sqlite
*.sqlite3

# Credentials, environment files, and browser session state.
.env
.env.*
.envrc
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.auth/
.aws/
.ssh/
credentials*
secrets*
*storage*state*.json
cookies*.json
